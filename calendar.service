[Unit]
Description=Unified Calendar App
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/data/_Github/unified_calendar
# node is installed via nvm, so /usr/bin/npm does not exist here. Call node
# directly with an absolute path; update the version below after an nvm upgrade.
ExecStart=%h/.nvm/versions/node/v24.11.1/bin/node server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
