# ─────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in your real credentials.
#   cp .env.example .env
# Never commit your real .env file.
# ─────────────────────────────────────────────────────────────

# Where the app runs locally
PORT=3000
BASE_URL=http://localhost:3000

# Secret used to sign session cookies (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: protect the app with a password when running on a server.
# Leave blank (or remove) to disable authentication for local use.
# AUTH_PASSWORD=your-secret-password

# ── Microsoft Azure (Outlook / Microsoft Graph) ──
# From: Azure Portal > App registrations > your app
MICROSOFT_CLIENT_ID=your-azure-application-client-id
MICROSOFT_CLIENT_SECRET=your-azure-client-secret-value
# Use "common" to allow both work/school and personal Microsoft accounts,
# or your specific tenant ID to restrict to your organization only.
MICROSOFT_TENANT=common

# ── Google Cloud (Google Calendar) ──
# From: Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional — let the widget cache events on disk (data/widget-cache.json) so it
# still shows them when a provider is unreachable. Off unless set to 1 / true:
# UNIFIED_CALENDAR_WIDGET_CACHE=1

# Network interface to bind to. Defaults to 127.0.0.1 (this machine only).
# Set 0.0.0.0 only alongside AUTH_PASSWORD, and preferably behind a VPN or TLS proxy.
# HOST=127.0.0.1
